# ==============================================================================
# ASFES Multiplex — Пример файла конфигурации (.env.example)
# ==============================================================================
# Скопируйте этот файл в файл ".env" в корневой директории проекта
# и настройте значения в соответствии с требованиями вашей среды.
#
# ВНИМАНИЕ: Не коммитьте реальный файл ".env" с секретами в Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОБЩИЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ (APP__*)
# ------------------------------------------------------------------------------

# APP__NAME: Название системы, отображаемое в интерфейсе и заголовках.
# Пример: "ASFES Multiplex", "My Home Server Control"
APP__NAME=ASFES Multiplex

# APP__ENV: Режим работы окружения.
# Допустимые значения: "development" (разработка), "production" (прод)
# В режиме "production" активируются повышенные требования к безопасности.
APP__ENV=production

# APP__DEV: Флаг режима разработки.
# Допустимые значения: true, false
# Если установлено true, разрешаются небезопасные cookie, включается подробный дебаг.
APP__DEV=false

# APP__HOST: Сетевой интерфейс (IP-адрес), который будет слушать веб-сервер.
# Примеры:
#   - 0.0.0.0 (слушать все интерфейсы, доступно из локальной сети)
#   - 127.0.0.1 (доступно только локально на текущем хосте)
APP__HOST=0.0.0.0

# APP__PORT: Сетевой порт, на котором запускается веб-сервер.
# Пример: 8000, 8080, 5000
APP__PORT=8000

# APP__PUBLIC_BASE_URL: Внешний базовый URL, по которому веб-приложение доступно пользователям.
# Используется для генерации OAuth-ссылок, обратных вызовов (callbacks) и заголовков.
# Важно указать протокол (http/https). Без закрывающего слэша.
# Примеры:
#   - https://multiplex.asfes.ru
#   - http://localhost:8000
APP__PUBLIC_BASE_URL=https://multiplex.asfes.ru

# APP__API_PREFIX: URL-префикс для REST API запросов. Должен начинаться с "/".
# По умолчанию: /api
APP__API_PREFIX=/api

# APP__MCP_PATH: URL-путь для SSE-подключений шлюза Model Context Protocol (MCP).
# Должен начинаться с "/" и отличаться от APP__API_PREFIX.
# По умолчанию: /mcp
APP__MCP_PATH=/mcp

# APP__FRONTEND_DIST: Путь к собранным статическим файлам React SPA.
# Может быть относительным от корня проекта или абсолютным.
# По умолчанию: frontend/dist
APP__FRONTEND_DIST=frontend/dist

# APP__STARTUP_PROGRESS: Флаг отображения индикатора прогресса при запуске backend.
# Допустимые значения: true, false
APP__STARTUP_PROGRESS=true

# APP__TRUSTED_PROXY_IPS: JSON-массив IP-адресов доверенных прокси-серверов (например, Nginx).
# Используется для корректного определения реального IP клиента из X-Forwarded-For.
# Примеры:
#   - ["127.0.0.1", "::1"] (локальный Nginx на том же хосте)
#   - ["192.168.1.50"] (прокси-сервер в локальной сети)
APP__TRUSTED_PROXY_IPS=["127.0.0.1","::1"]


# ------------------------------------------------------------------------------
# 2. НАСТРОЙКИ СУБД MONGODB (MONGO__*)
# ------------------------------------------------------------------------------

# MONGO__URI: Строка подключения (connection string) к MongoDB.
# Подключение обязательно, без рабочей MongoDB backend не запустится.
# Примеры:
#   - mongodb://127.0.0.1:27017 (локальная БД без авторизации)
#   - mongodb://admin:mysecurepassword@127.0.0.1:27017/asfes_multiplex?authSource=admin (с авторизацией)
MONGO__URI=mongodb://127.0.0.1:27017

# MONGO__DATABASE: Имя базы данных приложения.
# По умолчанию: asfes_multiplex
MONGO__DATABASE=asfes_multiplex

# MONGO__CONNECT_TIMEOUT_MS: Таймаут подключения к MongoDB в миллисекундах.
# По умолчанию: 5000 (5 секунд)
MONGO__CONNECT_TIMEOUT_MS=5000

# MONGO__SERVER_SELECTION_TIMEOUT_MS: Таймаут выбора сервера MongoDB в миллисекундах.
# По умолчанию: 5000 (5 секунд)
MONGO__SERVER_SELECTION_TIMEOUT_MS=5000

# MONGO__MAX_POOL_SIZE: Максимальное количество одновременных подключений в пуле.
# По умолчанию: 50
MONGO__MAX_POOL_SIZE=50


# ------------------------------------------------------------------------------
# 3. НАСТРОЙКИ REDIS (REDIS__*) — Опционально
# ------------------------------------------------------------------------------

# REDIS__MODE: Режим работы с Redis.
# Допустимые значения:
#   - disabled (Redis отключен, лимиты и кэш работают в локальной оперативной памяти)
#   - runtime  (Redis используется, если доступен. При падении сервер переходит на In-Memory режим)
#   - required (Redis обязателен. Приложение падает при старте, если нет подключения к Redis)
REDIS__MODE=runtime

# REDIS__URL: URL-адрес подключения к Redis.
# Обязателен, если REDIS__MODE равен "runtime" или "required".
# Примеры:
#   - redis://127.0.0.1:6379/0
#   - redis://:userpassword@127.0.0.1:6379/0
REDIS__URL=redis://127.0.0.1:6379/0

# REDIS__ENABLED_ON_STARTUP: Попытаться ли подключиться к Redis сразу при инициализации приложения.
# Допустимые значения: true, false
REDIS__ENABLED_ON_STARTUP=false


# ------------------------------------------------------------------------------
# 4. НАСТРОЙКИ ПОЧТОВОГО СЕРВЕРА SMTP (SMTP__*) — Опционально
# ------------------------------------------------------------------------------

# SMTP__ENABLED: Включить или выключить отправку email уведомлений.
# Допустимые значения: true, false
SMTP__ENABLED=false

# SMTP__HOST: Хост SMTP сервера. Обязателен, если SMTP__ENABLED=true.
# Примеры: smtp.gmail.com, smtp.yandex.ru, mail.privateemail.com
SMTP__HOST=smtp.example.com

# SMTP__PORT: Сетевой порт SMTP сервера.
# Примеры: 587 (для STARTTLS, обычно), 465 (для SSL/TLS), 25 (без шифрования)
SMTP__PORT=587

# SMTP__USERNAME: Имя пользователя для авторизации на почтовом сервере.
# Пример: mailer@example.com
SMTP__USERNAME=mailer@example.com

# SMTP__PASSWORD: Пароль или специальный App Password от вашей почты.
SMTP__PASSWORD=change-me

# SMTP__FROM_EMAIL: Адрес отправителя, который будет указан в отправляемых письмах.
# Должен быть валидным email адресом.
# Пример: no-reply@asfes.ru
SMTP__FROM_EMAIL=mailer@example.com

# SMTP__USE_SSL: Использовать ли чистое SSL соединение (обычно порт 465).
# Допустимые значения: true, false
SMTP__USE_SSL=false

# SMTP__STARTTLS: Использовать ли STARTTLS шифрование (обычно порт 587).
# Допустимые значения: true, false
SMTP__STARTTLS=true

# SMTP__TIMEOUT_SECONDS: Таймаут на отправку писем и подключение к SMTP в секундах.
# По умолчанию: 10
SMTP__TIMEOUT_SECONDS=10


# ------------------------------------------------------------------------------
# 5. СУПЕРАДМИНИСТРАТОР (ROOT__*)
# ------------------------------------------------------------------------------
# Эти параметры задают учетные данные главного администратора (Root).
# Создается автоматически при первом запуске приложения, если отсутствует в базе данных.

# ROOT__USERNAME: Логин суперадминистратора. Должен быть не менее 3 символов.
# Пример: root, admin, sysadmin
ROOT__USERNAME=root

# ROOT__PASSWORD: Пароль суперадминистратора. Должен быть не менее 12 символов.
# ВНИМАНИЕ: Дефолтный пароль "ChangeMeRootPassword123!" заблокирует старт в prod-окружении!
# Обязательно укажите свой уникальный надежный пароль.
ROOT__PASSWORD=ChangeMeRootPassword123!

# ROOT__EMAIL: Адрес электронной почты суперадминистратора.
# Пример: admin@yourdomain.com
ROOT__EMAIL=root@multiplex.asfes.ru

# ROOT__DISPLAY_NAME: Отображаемое имя суперадминистратора в системе.
# Пример: "Главный Администратор", "Root"
ROOT__DISPLAY_NAME=Root


# ------------------------------------------------------------------------------
# 6. НАСТРОЙКИ ЛОГИРОВАНИЯ (LOGGING__*)
# ------------------------------------------------------------------------------

# LOGGING__LEVEL: Уровень детализации логов.
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL
# По умолчанию: INFO
LOGGING__LEVEL=INFO

# LOGGING__DIRECTORY: Директория для хранения логов в виде файлов.
# Может быть относительным или абсолютным путем.
# По умолчанию: runtime/logs
LOGGING__DIRECTORY=runtime/logs

# LOGGING__SQLITE_PATH: Путь к файлу SQLite базы данных целостности/аудита логов.
# Используется для обеспечения защиты логов от несанкционированного изменения.
# По умолчанию: runtime/multiplex_logs.db
LOGGING__SQLITE_PATH=runtime/multiplex_logs.db

# LOGGING__VERIFIER_INTERVAL_SECONDS: Интервал (в секундах) фоновой проверки целостности логов.
# По умолчанию: 600 (10 минут)
LOGGING__VERIFIER_INTERVAL_SECONDS=600

# LOGGING__CONSOLE_RICH_TRACEBACKS: Включить ли интерактивное форматирование ошибок (Rich Tracebacks) в консоли.
# Допустимые значения: true, false
LOGGING__CONSOLE_RICH_TRACEBACKS=true


# ------------------------------------------------------------------------------
# 7. УПРАВЛЕНИЕ ХОСТОМ И СИСТЕМОЙ (HOST_OPS__*)
# ------------------------------------------------------------------------------
# Данный раздел настраивает права и пути для модулей управления сервером (host_ops)
# через API и MCP инструменты (работа с файлами, процессами, VPN, Nginx, Docker).

# HOST_OPS__MANAGED_FILE_ROOTS: JSON-массив корневых папок, в пределах которых разрешены
# операции чтения и записи файлов через host tools. Запросы к файлам вне этих путей блокируются.
# Пример: ["data", "runtime", "/var/www"]
HOST_OPS__MANAGED_FILE_ROOTS=["data","runtime"]

# HOST_OPS__MANAGED_LOG_ROOTS: JSON-массив папок, из которых разрешено читать логи хоста.
# Пример: ["runtime/logs", "/var/log/nginx"]
HOST_OPS__MANAGED_LOG_ROOTS=["runtime/logs"]

# HOST_OPS__BACKUP_DIRECTORY: Папка для складывания создаваемых бэкапов системы.
# По умолчанию: runtime/backups
HOST_OPS__BACKUP_DIRECTORY=runtime/backups

# HOST_OPS__COMMAND_TIMEOUT_SECONDS: Максимальное время выполнения внешней команды в секундах.
# По умолчанию: 30
HOST_OPS__COMMAND_TIMEOUT_SECONDS=30

# HOST_OPS__MAX_OUTPUT_BYTES: Лимит размера вывода консольной команды в байтах.
# Предотвращает переполнение памяти при слишком длинном выводе.
# По умолчанию: 65536 (64 КБ)
HOST_OPS__MAX_OUTPUT_BYTES=65536

# HOST_OPS__ALERT_POLL_INTERVAL_SECONDS: Интервал опроса триггеров системных алертов в секундах.
# По умолчанию: 60
HOST_OPS__ALERT_POLL_INTERVAL_SECONDS=60

# HOST_OPS__EXECUTABLE_OVERRIDES: JSON-словарь для переопределения путей к исполняемым файлам.
# Полезно, если системная утилита лежит по нестандартному пути.
# Пример: {"docker": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe", "nginx": "/usr/local/nginx/sbin/nginx"}
HOST_OPS__EXECUTABLE_OVERRIDES={}

# HOST_OPS__PROVIDER_OVERRIDES: JSON-словарь для переопределения провайдеров некоторых команд.
# Пример: {"firewall": "ufw"} (использовать UFW вместо iptables)
HOST_OPS__PROVIDER_OVERRIDES={}

# HOST_OPS__DATABASE_PROFILES_DIRECTORY: Папка для хранения профилей конфигурации баз данных.
# По умолчанию: data/profiles/databases
HOST_OPS__DATABASE_PROFILES_DIRECTORY=data/profiles/databases

# HOST_OPS__VPN_PROFILES_DIRECTORY: Папка для хранения профилей VPN подключений (например, WireGuard, OpenVPN).
# По умолчанию: data/profiles/vpn
HOST_OPS__VPN_PROFILES_DIRECTORY=data/profiles/vpn

# HOST_OPS__SSL_PROFILES_DIRECTORY: Папка для хранения профилей и сертификатов SSL.
# По умолчанию: data/profiles/ssl
HOST_OPS__SSL_PROFILES_DIRECTORY=data/profiles/ssl

# HOST_OPS__NGINX_CONFIG_PATHS: JSON-массив путей к директориям конфигурации Nginx, которыми можно управлять.
# Пример: ["data/nginx", "/etc/nginx/sites-enabled"]
HOST_OPS__NGINX_CONFIG_PATHS=["data/nginx"]

# HOST_OPS__PROCESS_ALLOWED_EXECUTABLES: JSON-массив имен или путей исполняемых файлов,
# которые разрешено запускать через API управления процессами. Если пуст [], запуск запрещен.
# Примеры:
#   - [] (запуск любых процессов извне заблокирован)
#   - ["ping", "git", "systemctl", "docker"] (разрешен запуск только указанных команд)
HOST_OPS__PROCESS_ALLOWED_EXECUTABLES=[]

# HOST_OPS__PORT_PROBE_ALLOWED_HOSTS: JSON-массив хостов/IP, которые разрешено сканировать на открытые порты.
# По умолчанию: ["127.0.0.1", "::1", "localhost"]
HOST_OPS__PORT_PROBE_ALLOWED_HOSTS=["127.0.0.1","::1","localhost"]


# ------------------------------------------------------------------------------
# 8. БЕЗОПАСНОСТЬ И КРИПТОГРАФИЯ (SECURITY__*)
# ------------------------------------------------------------------------------
# Настройки сессий, кук и секретных ключей.
# ВНИМАНИЕ: Обязательно замените дефолтные "change-this-..." секреты перед деплоем!

# SECURITY__API_JWT_SECRET: Секретный ключ для подписи сессионных JWT токенов API.
# Должен быть длинной случайной строкой. Пример: результат выполнения команды `openssl rand -hex 32`
SECURITY__API_JWT_SECRET=change-this-api-secret

# SECURITY__OAUTH_JWT_SECRET: Секретный ключ для подписи JWT токенов OAuth (MCP авторизация).
# Должен быть длинной случайной строкой. Пример: результат выполнения команды `openssl rand -hex 32`
SECURITY__OAUTH_JWT_SECRET=change-this-oauth-secret

# SECURITY__PROXY_ENCRYPTION_KEY: Ключ шифрования паролей прокси-серверов.
# Должен отличаться от других секретов для предотвращения компрометации (Key Separation).
SECURITY__PROXY_ENCRYPTION_KEY=ChangeThisProxyEncryptionKey

# SECURITY__PASSWORD_PEPPER: Дополнительный секретный "солевой" ключ (pepper) для хэширования паролей.
# Должен быть уникальным и длинным. Меняться в процессе эксплуатации не должен (иначе старые пароли не подойдут).
SECURITY__PASSWORD_PEPPER=change-this-password-pepper

# SECURITY__ACCESS_TOKEN_TTL_MINUTES: Время жизни JWT Access Token для API в минутах.
# По умолчанию: 15
SECURITY__ACCESS_TOKEN_TTL_MINUTES=15

# SECURITY__REFRESH_TOKEN_TTL_DAYS: Время жизни Refresh Token для API в днях.
# По умолчанию: 30
SECURITY__REFRESH_TOKEN_TTL_DAYS=30

# SECURITY__OAUTH_ACCESS_TOKEN_TTL_MINUTES: Время жизни OAuth Access Token (для MCP клиентов) в минутах.
# По умолчанию: 30
SECURITY__OAUTH_ACCESS_TOKEN_TTL_MINUTES=30

# SECURITY__OAUTH_REFRESH_TOKEN_TTL_DAYS: Время жизни OAuth Refresh Token в днях.
# По умолчанию: 30
SECURITY__OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# SECURITY__OAUTH_AUTHORIZATION_CODE_TTL_MINUTES: Время жизни кода авторизации OAuth в минутах.
# По умолчанию: 10
SECURITY__OAUTH_AUTHORIZATION_CODE_TTL_MINUTES=10

# SECURITY__SESSION_COOKIE_NAME: Название cookie-файла для хранения токена сессии.
# По умолчанию: multiplex_session
SECURITY__SESSION_COOKIE_NAME=multiplex_session

# SECURITY__CSRF_COOKIE_NAME: Название cookie-файла для защиты от CSRF.
# По умолчанию: multiplex_csrf
SECURITY__CSRF_COOKIE_NAME=multiplex_csrf

# SECURITY__COOKIE_SECURE: Устанавливать ли атрибут Secure для кук.
# Если true, куки будут передаваться только по HTTPS. В production должно быть true.
# Допустимые значения: true, false
SECURITY__COOKIE_SECURE=true

# SECURITY__COOKIE_SAMESITE: Политика SameSite для кук приложения.
# Допустимые значения: lax, strict, none
# По умолчанию: lax
SECURITY__COOKIE_SAMESITE=lax

# SECURITY__ALLOW_INSECURE_COOKIES: Разрешить передачу сессионных кук по HTTP без HTTPS (для локальной разработки).
# Допустимые значения: true, false
SECURITY__ALLOW_INSECURE_COOKIES=false

# SECURITY__API_AUDIENCE: Идентификатор аудитории (audience claim) для валидации токенов API.
# По умолчанию: multiplex-api
SECURITY__API_AUDIENCE=multiplex-api

# SECURITY__MCP_AUDIENCE: Идентификатор аудитории для валидации токенов MCP.
# По умолчанию: multiplex-mcp
SECURITY__MCP_AUDIENCE=multiplex-mcp


# ------------------------------------------------------------------------------
# 9. ПОЛИТИКА СЛОЖНОСТИ ПАРОЛЕЙ (PASSWORD_POLICY__*)
# ------------------------------------------------------------------------------

# PASSWORD_POLICY__MIN_LENGTH: Минимальное количество символов в пароле пользователя.
# По умолчанию: 12
PASSWORD_POLICY__MIN_LENGTH=12

# PASSWORD_POLICY__FORBIDDEN_PASSWORDS: JSON-массив простых паролей, которые запрещено ставить пользователям.
PASSWORD_POLICY__FORBIDDEN_PASSWORDS=["password","password123","qwerty123","admin123","changeme","changemerootpassword123!"]


# ------------------------------------------------------------------------------
# 10. НАСТРОЙКИ OAUTH / PKCE (OAUTH__*)
# ------------------------------------------------------------------------------

# OAUTH__ISSUER_PATH: Относительный путь к эмиттеру OAuth.
# По умолчанию: /api/oauth
OAUTH__ISSUER_PATH=/api/oauth

# OAUTH__AUTHORIZATION_PATH: Путь к странице авторизации OAuth.
# По умолчанию: /api/oauth/authorize
OAUTH__AUTHORIZATION_PATH=/api/oauth/authorize

# OAUTH__TOKEN_PATH: Путь к получению OAuth токена (token endpoint).
# По умолчанию: /api/oauth/token
OAUTH__TOKEN_PATH=/api/oauth/token

# OAUTH__REVOCATION_PATH: Путь к отзыву токена OAuth (revoke endpoint).
# По умолчанию: /api/oauth/revoke
OAUTH__REVOCATION_PATH=/api/oauth/revoke

# OAUTH__CLIENTS_PATH: Путь управления зарегистрированными OAuth-клиентами.
# По умолчанию: /api/oauth/clients
OAUTH__CLIENTS_PATH=/api/oauth/clients

# OAUTH__JWKS_PATH: Путь к набору публичных ключей (JWKS) для валидации токенов внешними сервисами.
# По умолчанию: /api/oauth/jwks
OAUTH__JWKS_PATH=/api/oauth/jwks

# OAUTH__SUPPORTED_SCOPES: JSON-массив поддерживаемых прав доступа (scopes) для MCP клиентов.
# Допустимые значения: "mcp", "profile" и т.д.
OAUTH__SUPPORTED_SCOPES=["mcp","profile"]

# OAUTH__REQUIRE_PKCE: Обязательно ли требовать механизм PKCE для всех OAuth авторизаций.
# Допустимые значения: true, false
OAUTH__REQUIRE_PKCE=true

# OAUTH__ALLOW_PLAIN_PKCE: Разрешить ли простой метод (plain text) в PKCE вместо безопасного S256.
# Крайне рекомендуется держать false для защиты от перехвата кодов.
# Допустимые значения: true, false
OAUTH__ALLOW_PLAIN_PKCE=false


# ------------------------------------------------------------------------------
# 11. ОГРАНИЧЕНИЕ ЧАСТОТЫ ЗАПРОСОВ (RATE_LIMITS__*) — Rate Limiting
# ------------------------------------------------------------------------------
# Лимиты настраиваются парами: LIMIT (число запросов) и WINDOW_SECONDS (период в секундах).
# Пример: LIMIT=5 и WINDOW_SECONDS=60 означает максимум 5 запросов за 1 минуту.

# Лимиты на попытки входа в систему (Login):
RATE_LIMITS__LOGIN_LIMIT=5
RATE_LIMITS__LOGIN_WINDOW_SECONDS=60

# Лимиты на попытки регистрации (Register):
RATE_LIMITS__REGISTER_LIMIT=3
RATE_LIMITS__REGISTER_WINDOW_SECONDS=3600

# Лимиты на запросы получения/обновления токенов OAuth:
RATE_LIMITS__OAUTH_TOKEN_LIMIT=20
RATE_LIMITS__OAUTH_TOKEN_WINDOW_SECONDS=60

# Лимиты на чтение через REST API (GET запросы):
RATE_LIMITS__REST_READ_LIMIT=60
RATE_LIMITS__REST_READ_WINDOW_SECONDS=60

# Лимиты на изменение через REST API (POST, PUT, PATCH, DELETE запросы):
RATE_LIMITS__REST_WRITE_LIMIT=20
RATE_LIMITS__REST_WRITE_WINDOW_SECONDS=60

# Лимиты на чтение данных через MCP (Model Context Protocol):
RATE_LIMITS__MCP_READ_LIMIT=30
RATE_LIMITS__MCP_READ_WINDOW_SECONDS=60

# Лимиты на запись/вызов действий (tools) через MCP:
RATE_LIMITS__MCP_WRITE_LIMIT=10
RATE_LIMITS__MCP_WRITE_WINDOW_SECONDS=300

# ==============================================================================
# 12. PyPI MIRROR SETTINGS (PYPI__*)
# ==============================================================================

# PYPI__ENABLED: Включить PyPI-зеркало.
# При false — Simple API (/pypi/simple/) и management API (/api/pypi/) недоступны.
PYPI__ENABLED=true

# PYPI__DATA_DIR: Путь к директории хранилища пакетов.
# Может быть абсолютным (для монтируемых томов в Docker) или относительным от корня проекта.
# Примеры:
#   data/pypi_storage           (относительный, по умолчанию)
#   /mnt/storage/pypi           (абсолютный, для Docker-томов)
PYPI__DATA_DIR=data/pypi_storage

# PYPI__SIMPLE_PATH: URL-префикс pip-совместимого Simple API.
# Пример использования: pip install flask --index-url http://host:8000/pypi/simple/
PYPI__SIMPLE_PATH=/pypi

# PYPI__API_BASE: Адрес upstream PyPI JSON API для получения метаданных.
PYPI__API_BASE=https://pypi.org/pypi

# PYPI__PARALLEL: Количество параллельных соединений при скачивании.
PYPI__PARALLEL=5

# PYPI__MAX_RETRIES: Число повторных попыток при ошибке сети.
PYPI__MAX_RETRIES=3

# PYPI__REQUEST_TIMEOUT: Общий таймаут HTTP-запроса (секунды).
PYPI__REQUEST_TIMEOUT=30.0

# PYPI__CONNECT_TIMEOUT: Таймаут соединения (секунды).
PYPI__CONNECT_TIMEOUT=10.0

# PYPI__MIN_SAFE_SPACE_GB: Минимум свободного места для начала скачивания (ГБ).
# Скачивание будет отклонено, если свободно меньше указанного значения.
PYPI__MIN_SAFE_SPACE_GB=3.0

# PYPI__RATE_LIMIT_MB: Ограничение скорости скачивания (МБ/с).
# Закомментируйте или оставьте пустым для снятия ограничения.
# PYPI__RATE_LIMIT_MB=

# PYPI__PUBLIC_ACCESS: true = Simple API доступен без авторизации (рекомендуется).
# Для защищённого доступа: pip install --index-url https://user:pass@host/pypi/simple/ pkg
PYPI__PUBLIC_ACCESS=true

# PYPI__ON_DEMAND_PROXY: true = при обращении к отсутствующему файлу —
# скачать с PyPI и сохранить в хранилище (прозрачное кеширование).
PYPI__ON_DEMAND_PROXY=true

# PYPI__VERIFY_SSL: Проверять SSL-сертификат при запросах к upstream PyPI.
PYPI__VERIFY_SSL=true

# PYPI__NETWORK_MODE: Режим работы с сетью.
# Допустимые значения:
#   direct  — прямое подключение к PyPI (по умолчанию)
#   proxy   — всегда через прокси из PYPI__PROXIES
#   mix     — случайный выбор между прямым и прокси
PYPI__NETWORK_MODE=direct

# PYPI__PROXIES: Список прокси через запятую (для режимов proxy/mix).
# Формат: http://host:port или socks5://host:port
# PYPI__PROXIES=http://proxy1:3128,http://proxy2:3128

# --- Home Assistant Integration -------------------------------------------
# HA__ENABLED: ��������/��������� HA-����������
HA__ENABLED=true

# TTL access token ��� HA (������)
HA__ACCESS_TOKEN_TTL_MINUTES=30

# TTL refresh token ��� HA (���)
HA__REFRESH_TOKEN_TTL_DAYS=365

# ������������� �������� polling (���)
HA__DEFAULT_POLL_INTERVAL_SECONDS=30

# ��������� JWT-������ ��� HA access tokens. ������������: openssl rand -hex 32
HA__JWT_SECRET=change-this-ha-jwt-secret

# ��������� JWT-������ ��� HA refresh tokens
HA__REFRESH_JWT_SECRET=change-this-ha-refresh-jwt-secret

# ��������� ���������� switches (�� ��������� false - ������� ������ ���������)
HA__SWITCHES_ENABLED=false

# ��������� ������������� ������ (restart_multiplex, restart_docker)
HA__DESTRUCTIVE_BUTTONS_ENABLED=false
